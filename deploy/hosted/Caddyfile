# braveduck shared server: Caddy terminates HTTPS (certificates from Let's
# Encrypt, automatic), asks Authelia about every request, and passes the
# logged-in user on to braveduck.
#
# The domains come from .env (see setup.sh); the upstreams default to the
# compose service names.

{
	email {$ACME_EMAIL}
}

# HTTPS only from the first visit on, no MIME sniffing, no referrers sent on.
(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
	}
}

# The login portal.
{$AUTH_DOMAIN} {
	import security_headers
	reverse_proxy {$AUTH_UPSTREAM:authelia:9091}
}

# Only Authelia may name the user: drop whatever the client sent.
(drop_identity) {
	request_header -Remote-User
	request_header -Remote-Groups
	request_header -Remote-Email
	request_header -Remote-Name
	request_header -X-Braveduck-Proxy-Secret
}

# To braveduck: the secret proves the request came through here; the login
# cookie stays behind (braveduck doesn't need it).
(to_braveduck) {
	reverse_proxy {$BRAVEDUCK_UPSTREAM:braveduck:8080} {
		header_up X-Braveduck-Proxy-Secret {file.{$SECRETS_DIR:/run/secrets}/proxy_secret}
		header_up -Cookie
	}
}

# The board. `route` keeps the directives in the order written.
{$BRAVEDUCK_DOMAIN} {
	import security_headers

	# AI agents: braveduck checks the agent key made on the user's board, so
	# no password ever goes into an agent's config.
	handle /mcp {
		route {
			import drop_identity
			import to_braveduck
		}
	}

	handle {
		route {
			import drop_identity
			forward_auth {$AUTH_UPSTREAM:authelia:9091} {
				uri /api/authz/forward-auth
				copy_headers Remote-User Remote-Groups Remote-Email Remote-Name
			}
			import to_braveduck
		}
	}
}
